# Copy to .env (or .env.production) and fill in.
#
# Absolute origin of the deployed API. REQUIRED for Android builds — the app is
# served from https://localhost inside the WebView, so relative "/api/..." paths
# resolve to the WebView itself and the shared-group (Lendr) feature 404s.
#
# Leave unset for plain web builds, where same-origin relative paths work.
VITE_API_BASE_URL=https://your-deployment.vercel.app
